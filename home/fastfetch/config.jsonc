{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	"type": "auto",
	"source": "~/.config/fastfetch/logo.txt",
	"width": 4,
        "padding": {
            "top": 1,
	    "right": 2
        },
	"color": {
		"1": "white"
	}
    },
    "display": {
        "separator": " -> ",
        "constants": [
            "──────────────────────────────"
        ]
    },
    "modules": [
        {
            "type": "custom",
            "format": "┌{$1}{$1}┐",
            "outputColor": "90"
        },
        {
            "type": "title",
            "keyWidth": 10
        },
        {
            "type": "custom",
            "format": "└{$1}{$1}┘",
            "outputColor": "90"
        },
        {
            "type": "custom",
            "format": " {#90}  {#31}  {#32}  {#33}  {#34}  {#35}  {#36}  {#37}  {#38}  {#39}       {#38}  {#37}  {#36}  {#35}  {#34}  {#33}  {#32}  {#31}  {#90}"
        },
        {
            "type": "custom",
            "format": "┌{$1}{$1}┐",
            "outputColor": "90"
        },
        {
            "type": "os",
	    "format": "{name} {version}",
            "key": "{icon} OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ ├{icon}",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
	    "format": "{nix-all} Nix packages, {flatpak-all} flatpaks",
            "key": "│ ├{icon}",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "│ └",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": " DE/WM",
            "keyColor": "blue"
        },
        {
            "type": "lm",
            "key": "│ ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "│ ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "│ ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "│ ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "wallpaper",
            "key": "│ └󰸉",
            "keyColor": "blue"
        },
        {
            "type": "host",
            "key": "󰌢 PC",
            "keyColor": "green"
        },
        {
            "type": "cpu",
	    "format": "{name}",
            "key": "│ ├{icon}",
            "keyColor": "green"
        },
        {
            "type": "gpu",
	    "format": "{name}",
            "key": "│ ├{icon}",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "│ ├{icon}",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "│ ├{icon}",
            "keyColor": "green"
        },
        {
            "type": "swap",
            "key": "│ ├{icon}",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "│ ├{icon}",
            "keyColor": "green"
        },
        {
            "type": "display",
	    "format": "{width}x{height} @ {refresh-rate} Hz",
            "key": "│ └󰍹",
            "keyColor": "green"
        },
	{
            "type": "custom",
            "format": "└{$1}{$1}┘",
            "outputColor": "90"
        },
        "break",
        {
            "type": "custom",
            "format": " {#90}  {#31}  {#32}  {#33}  {#34}  {#35}  {#36}  {#37}  {#38}  {#39}       {#38}  {#37}  {#36}  {#35}  {#34}  {#33}  {#32}  {#31}  {#90}"
        }
    ]
}
